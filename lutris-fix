#!/usr/bin/env bash
set -e

LUTRIS_BIN="/usr/bin/lutris"
BACKUP="/usr/bin/lutris.bak"

# Check if dialog or whiptail is available
if command -v dialog &> /dev/null; then
  TUI="dialog"
elif command -v whiptail &> /dev/null; then
  TUI="whiptail"
else
  TUI=""
fi

show_menu() {
  if [ -n "$TUI" ]; then
    $TUI --title "Lutris Python 3.14 Fix" --menu "Choose an option:" 15 60 4 \
      1 "Apply Python 3.14 fix to Lutris" \
      2 "Restore original Lutris" \
      3 "Exit" 2>&1 >/dev/tty
  else
    echo "=== Lutris Python 3.14 Fix ==="
    echo ""
    echo "1) Apply Python 3.14 fix to Lutris"
    echo "2) Restore original Lutris"
    echo "3) Exit"
    echo ""
    read -p "Choose an option (1-3): " choice
    echo "$choice"
  fi
}

show_message() {
  local title="$1"
  local message="$2"
  if [ -n "$TUI" ]; then
    $TUI --title "$title" --msgbox "$message" 10 60
  else
    echo ""
    echo "=== $title ==="
    echo "$message"
    echo ""
    read -p "Press Enter to continue..."
  fi
}

do_patch() {
  clear
  echo "Checking Lutris..."
  
  if grep -q 'multiprocessing.set_start_method("fork")' "$LUTRIS_BIN"; then
    show_message "Already Patched" "✓ Lutris already has the Python 3.14 fix applied!"
    return
  fi
  
  echo "Applying Python 3.14 fix to Lutris..."
  sudo cp "$LUTRIS_BIN" "$BACKUP"
  sudo sed -i '/^import sys$/a import multiprocessing\nmultiprocessing.set_start_method("fork")' "$LUTRIS_BIN"
  show_message "Success" "✓ Fix applied!\n\nLutris should now work with Python 3.14"
}

do_restore() {
  clear
  
  if [ ! -f "$BACKUP" ]; then
    show_message "No Backup" "No backup found. Nothing to restore."
    return
  fi
  
  echo "Restoring original Lutris..."
  sudo mv "$BACKUP" "$LUTRIS_BIN"
  show_message "Success" "✓ Original Lutris restored!"
}

# If arguments provided, use command-line mode
if [ $# -gt 0 ]; then
  case "$1" in
    enable)
      do_patch
      ;;
    rollback)
      do_restore
      ;;
    *)
      echo "Usage: $0 {enable|rollback}"
      exit 1
      ;;
  esac
  exit 0
fi

# Interactive TUI mode
while true; do
  choice=$(show_menu)
  
  case $choice in
    1)
      do_patch
      break
      ;;
    2)
      do_restore
      break
      ;;
    3|"")
      clear
      echo "Goodbye!"
      exit 0
      ;;
  esac
done